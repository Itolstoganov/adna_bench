import shlex
from itertools import product

configfile: "configs/config.yaml"

include: "rules/alignment.smk"
include: "rules/pipeline.smk"

localrules:
    plots, resources, index_resources, accuracy_tables, resource_tables, k_plots, combined_k_plots, summary_plots

MODES = config.get("modes", ("align"))
ENDS = config.get("ends", ("pe"))

DATASET_CONFIGS = expand_datasets(config.get("datasets", []))
DATASET_IDS = list(DATASET_CONFIGS.keys())

k_values = config.get("k", [None])
syncmer_density = config.get("syncmer_density", 5)
VERSIONS = {}
for version in config.get("versions", []):
    for k in k_values:
        arg = version.get("arguments", "")
        if k is not None:
            full_arg = f"{arg} -k {k} -s {k - syncmer_density + 1}" if arg else f"-k {k}"
        else:
            full_arg = arg
        key = version["commit"]
        if full_arg:
            key += "-" + full_arg.replace(" ", "").replace("-", "").replace("=", "")
        display_name = version["name"]
        if k is not None and len(k_values) > 1:
            display_name += f" (k={k})"
        VERSIONS[key] = {
            "commit": version["commit"],
            "arguments": f" {full_arg}" if full_arg else "",
            "name": display_name,
            "base_name": version["name"],
            "binary": f"bin/strobealign/{version['commit']}",
            "k": k,
        }

PROGRAMS = expand("strobealign-{key}", key=VERSIONS.keys())

BWAMEM_K_PROGRAMS = {}
if "bwamem" in config.get("programs", []) and len(k_values) > 1:
    for k in k_values:
        prog_name = f"bwamem-k{k}"
        BWAMEM_K_PROGRAMS[prog_name] = {
            "name": f"bwa mem (k={k})",
            "base_name": "bwa mem",
            "k": str(k),
        }

if config["programs"]:
    for prog in config["programs"]:
        if prog == "bwamem" and BWAMEM_K_PROGRAMS:
            PROGRAMS.extend(BWAMEM_K_PROGRAMS.keys())
        else:
            PROGRAMS.append(prog)
PLOTS = ("accuracy", "aligned", "time", "memory")

# Strobealign version names in config order, passed to plots.py so every plot
# uses the same color and marker for a version (shared/scripts/tool_style.py).
STROBEALIGN_ORDER = list(dict.fromkeys(v["base_name"] for v in VERSIONS.values()))
if len(STROBEALIGN_ORDER) > 5:
    raise ValueError(f"at most 5 strobealign versions are supported, got {len(STROBEALIGN_ORDER)}")
TOOL_ARGS = " ".join(shlex.quote(f"--strobealign={name}") for name in STROBEALIGN_ORDER)


ACCURACY_METRICS = [
    "mapped_endogenous",
    "accuracy",
    "mapped_endogenous_deam",
    "accuracy_deam",
    "mapped_bacterial",
    "mapped_contaminated",
]

# Optional secondary-alignment accuracy (off by default). Toggled via config or `run.py --secondary-accuracy`.
SECONDARY_ACCURACY = str(config.get("secondary_accuracy", False)).strip().lower() in ("1", "true", "yes", "on")
SECONDARY_N = config.get("secondary_n", 100)
SECONDARY_M = config.get("secondary_m", 100)
SECONDARY_S = config.get("secondary_s", 0.5)
# Single source of truth for the secondary metrics: (table column, plot slug).
# Mirrors SECONDARY_METRICS in scripts/plots.py.
SECONDARY_METRICS = [
    ("% Accuracy with secondary (endogenous only)", "accuracy_secondary"),
    ("% Accuracy with secondary (deaminated endogenous only)", "accuracy_secondary_deam"),
]
SECONDARY_METRIC_COLUMNS = [column for column, _slug in SECONDARY_METRICS]
if SECONDARY_ACCURACY:
    ACCURACY_METRICS = ACCURACY_METRICS + [slug for _column, slug in SECONDARY_METRICS]


def secondary_applicable(prog):
    # secondary accuracy is not meaningful for bwaaln / safari
    return prog.startswith("strobealign") or prog.startswith("bwamem")


def strobealign_secondary_args(version_args):
    """Flags to make strobealign emit secondaries. -N is upper-bounded by -M and
    depends on -S; only add -M/-S when the version doesn't already set them."""
    if not SECONDARY_ACCURACY:
        return ""
    tokens = version_args.split()
    parts = [f"-N {SECONDARY_N}"]
    if "-M" not in tokens:
        parts.append(f"-M {SECONDARY_M}")
    if "-S" not in tokens:
        parts.append(f"-S {SECONDARY_S}")
    return " " + " ".join(parts)


# Accuracy metrics get both non-k (vs score threshold) and k plots.
# Resource metrics (runtime, memory) are k-metrics only (line vs k).
PLOT_METRICS = ACCURACY_METRICS
RESOURCE_K_METRICS = ["k_runtime", "k_memory"]
SCORE_THRESHOLDS = config.get("score_thresholds", [25, 30, 35, 40, 45])
HAS_MULTI_K = len(k_values) > 1
K_PLOT_METRICS = ["k_" + m for m in PLOT_METRICS] + RESOURCE_K_METRICS

# Index construction resources, plotted with references (endogenous genomes) on the x axis.
INDEX_METRICS = ["index_runtime", "index_memory"]

# Summary plots (all datasets, one plot per metric): absolute accuracy metrics,
# their delta-vs-default counterparts, and the two resource metrics.
SUMMARY_PNG_METRICS = (
    PLOT_METRICS
    + [m + "_delta" for m in PLOT_METRICS]
    + RESOURCE_K_METRICS
    + ["k_memory_delta"]
    + INDEX_METRICS
    + ["outcome", "outcome_deam", "accuracy_deam_diff"]
)

rule final:
    input:
        expand("result/{dataset_id}/accuracy_table.tsv", dataset_id=DATASET_IDS),
        expand("result/{dataset_id}/resource_table.tsv", dataset_id=DATASET_IDS),
        expand("result/{dataset_id}/plots/{metric}.png", dataset_id=DATASET_IDS, metric=PLOT_METRICS),
        expand("result/{dataset_id}/plots/{metric}.png", dataset_id=DATASET_IDS, metric=K_PLOT_METRICS) if HAS_MULTI_K else [],
        "result/combined_k_plots.pdf" if HAS_MULTI_K else [],
        "result/summary_plots.pdf"


rule run_adna_accuracy:
    output:
        "csv/{prog}/{dataset_id}/accuracy.tsv"
    input:
        gt="datasets/{dataset_id}/ref_ground_truth.bed",
        bam="runs/{prog}/{dataset_id}/se.bam"
    params:
        thresholds=SCORE_THRESHOLDS,
        recompute_as = lambda wildcards: False if wildcards.prog.startswith("strobealign") else True,
        secondary_emit = SECONDARY_ACCURACY,
        secondary_compute = lambda wildcards: SECONDARY_ACCURACY and secondary_applicable(wildcards.prog)
    script:
        "scripts/adna_accuracy.py"


rule accuracy_tables:
    output:
        "result/{dataset_id}/accuracy_table.tsv"
    input:
        expand("csv/{prog}/{{dataset_id}}/accuracy.tsv", prog=PROGRAMS)
    params:
        programs=PROGRAMS,
        config=config
    run:
        import csv

        tool_info = {}
        for key, version in VERSIONS.items():
            prog_name = f"strobealign-{key}"
            tool_info[prog_name] = {
                "name": version["name"],
                "base_name": version["base_name"],
                "k": str(version["k"]) if version["k"] is not None else "",
            }

        for prog in config.get("programs", []):
            if prog == "bwamem" and BWAMEM_K_PROGRAMS:
                continue
            tool_info[prog] = {"name": prog, "base_name": "", "k": ""}

        for prog_name, info in BWAMEM_K_PROGRAMS.items():
            tool_info[prog_name] = info

        with open(output[0], 'w', newline='') as outfile:
            writer = csv.writer(outfile, delimiter='\t')
            header = [
                "Tool",
                "Base Name",
                "k",
                "Score Threshold",
                "% Mapped endogenous reads",
                "% Accuracy (endogenous only)",
                "% Mapped deaminated endogenous reads",
                "% Accuracy (deaminated endogenous only)",
                "% Mapped bacterial reads",
                "% Mapped contaminated reads"
            ]
            if SECONDARY_ACCURACY:
                header += SECONDARY_METRIC_COLUMNS
            writer.writerow(header)

            for prog, input_file in zip(params.programs, input):
                info = tool_info.get(prog, {"name": prog, "base_name": "", "k": ""})
                with open(input_file) as f:
                    for line in f:
                        values = line.strip().split('\t')
                        writer.writerow([info["name"], info["base_name"], info["k"]] + values)


rule resource_tables:
    output:
        "result/{dataset_id}/resource_table.tsv"
    input:
        res=expand("csv/{prog}/{{dataset_id}}/se.bam.resources.csv", prog=PROGRAMS),
        index=expand("csv/{prog}/{{dataset_id}}/index.resources.csv", prog=PROGRAMS)
    params:
        programs=PROGRAMS
    run:
        import csv

        tool_info = {}
        for key, version in VERSIONS.items():
            prog_name = f"strobealign-{key}"
            tool_info[prog_name] = {
                "name": version["name"],
                "base_name": version["base_name"],
                "k": str(version["k"]) if version["k"] is not None else "",
            }

        for prog in config.get("programs", []):
            if prog == "bwamem" and BWAMEM_K_PROGRAMS:
                continue
            tool_info[prog] = {"name": prog, "base_name": "", "k": ""}

        for prog_name, info in BWAMEM_K_PROGRAMS.items():
            tool_info[prog_name] = info

        with open(output[0], 'w', newline='') as outfile:
            writer = csv.writer(outfile, delimiter='\t')
            writer.writerow(["Tool", "Base Name", "k", "Mapping Time (s)", "Peak Memory (GB)",
                             "Index Time (s)", "Index Peak Memory (GB)"])

            for prog, res_file, index_file in zip(params.programs, input.res, input.index):
                info = tool_info.get(prog, {"name": prog, "base_name": "", "k": ""})
                with open(res_file) as f:
                    row = next(csv.DictReader(f))
                with open(index_file) as f:
                    index_row = next(csv.DictReader(f))
                mapping_time = row.get("mapping_time", "")
                memory = row.get("memory_gb", "")
                writer.writerow([info["name"], info["base_name"], info["k"], mapping_time, memory,
                                 index_row["index_time"], index_row["index_memory_gb"]])


rule plots:
    output:
        expand("result/{{dataset_id}}/plots/{metric}.png", metric=PLOT_METRICS)
    input:
        accuracy="result/{dataset_id}/accuracy_table.tsv",
        resources="result/{dataset_id}/resource_table.tsv"
    params:
        k=config.get("main_k", 17),
        tool_args=TOOL_ARGS
    shell:
        "python workflow/scripts/plots.py --input {input.accuracy} --resources {input.resources} --output-dir result/{wildcards.dataset_id}/plots --k {params.k} {params.tool_args}"


rule k_plots:
    output:
        expand("result/{{dataset_id}}/plots/{metric}.png", metric=K_PLOT_METRICS)
    input:
        accuracy="result/{dataset_id}/accuracy_table.tsv",
        resources="result/{dataset_id}/resource_table.tsv"
    params:
        threshold=config.get("main_score_threshold", 60),
        tool_args=TOOL_ARGS
    shell:
        "python workflow/scripts/plots.py --input {input.accuracy} --resources {input.resources} --output-dir result/{wildcards.dataset_id}/plots --k-plot --score-threshold {params.threshold} {params.tool_args}"


def _combined_dataset_label(dataset_id):
    """Row label for the combined PDF: dataset minus the variation suffix."""
    cfg = DATASET_CONFIGS[dataset_id]
    return f"{cfg['endogenous_genome']}_{cfg['contaminant_genome']}_{cfg['bacterial_db']}_len{cfg['read_length']}"


rule combined_k_plots:
    output:
        "result/combined_k_plots.pdf"
    input:
        accuracy=expand("result/{dataset_id}/accuracy_table.tsv", dataset_id=DATASET_IDS),
        resources=expand("result/{dataset_id}/resource_table.tsv", dataset_id=DATASET_IDS)
    params:
        threshold=config.get("main_score_threshold", 60),
        tool_args=TOOL_ARGS,
        dataset_args=lambda wildcards, input: " ".join(
            f"--dataset {d} {acc} {res} {_combined_dataset_label(d)} {DATASET_CONFIGS[d]['endogenous_variation']}"
            for d, acc, res in zip(DATASET_IDS, input.accuracy, input.resources)
        )
    shell:
        "python workflow/scripts/plots.py --combined-pdf {output} --score-threshold {params.threshold} {params.dataset_args} {params.tool_args}"


def _summary_dataset_arg(dataset_id, acc, res, gt):
    """Build a --summary-dataset argument: name, table paths, the components
    used to derive the shortened dataset label (genome, read length, variation),
    and the ground truth BED (for the deaminated read fraction)."""
    cfg = DATASET_CONFIGS[dataset_id]
    return (
        f"--summary-dataset {dataset_id} {acc} {res} "
        f"{cfg['endogenous_genome']} {cfg['read_length']} {cfg['endogenous_variation']} {gt}"
    )


rule summary_plots:
    output:
        pdf="result/summary_plots.pdf",
        pngs=expand("result/summary_plots/{metric}.png", metric=SUMMARY_PNG_METRICS)
    input:
        accuracy=expand("result/{dataset_id}/accuracy_table.tsv", dataset_id=DATASET_IDS),
        resources=expand("result/{dataset_id}/resource_table.tsv", dataset_id=DATASET_IDS),
        ground_truth=expand("datasets/{dataset_id}/ref_ground_truth.bed", dataset_id=DATASET_IDS)
    params:
        threshold=config.get("main_score_threshold", 60),
        main_k=config.get("main_k", 17),
        num_reads=config.get("num_reads"),
        tool_args=TOOL_ARGS,
        dataset_args=lambda wildcards, input: " ".join(
            _summary_dataset_arg(d, acc, res, gt)
            for d, acc, res, gt in zip(DATASET_IDS, input.accuracy, input.resources, input.ground_truth)
        )
    shell:
        "python workflow/scripts/plots.py --summary-pdf {output.pdf} --summary-png-dir result/summary_plots --main-k {params.main_k} --score-threshold {params.threshold} --num-reads {params.num_reads} {params.dataset_args} {params.tool_args}"


def index_log(wildcards):
    """Log holding the index construction measurements for a program, if any."""
    prog, dataset_id = wildcards.prog, wildcards.dataset_id
    if prog in ("bwaaln", "bwamem") or prog in BWAMEM_K_PROGRAMS:
        return f"datasets/{dataset_id}/ref.fa.bwa_index.log"
    if prog == "bowtie2":
        return f"datasets/{dataset_id}/ref.fa.bowtie2_index.log"
    if prog == "safari":
        return f"datasets/{dataset_id}/safari/ref.index.log"
    if prog.startswith("strobealign-"):
        # strobealign indexes on the fly; only its indexing time is reported separately
        return f"runs/{prog}/{dataset_id}/se.bam.log"
    return []


def _parse_wall_clock(value):
    seconds = 0.0
    for part in value.split(":"):
        seconds = seconds * 60 + float(part)
    return seconds


rule index_resources:
    output:
        csv="csv/{prog}/{dataset_id}/index.resources.csv"
    input:
        log=index_log
    run:
        index_time = ""
        memory = ""
        if input.log:
            with open(input.log) as f:
                lines = f.readlines()
            if wildcards.prog.startswith("strobealign-"):
                times = [float(l.split()[3]) for l in lines if l.startswith("Total time indexing:")]
                if times:
                    index_time = times[0]
            else:
                # multi-step indexers (safari) log one `time -v` block per step
                times = [_parse_wall_clock(l.split()[-1]) for l in lines if "Elapsed (wall clock)" in l]
                rss = [int(l.split()[-1]) for l in lines if "Maximum resident" in l]
                if times:
                    index_time = sum(times)
                if rss:
                    memory = max(rss) / 1048576
        with open(output.csv, "w") as f:
            f.write("prog,index_time,index_memory_gb\n")
            f.write(f"{wildcards.prog},{index_time},{memory}\n")


rule resources:
    output:
        csv="csv/{prog}/{dataset_id}/{ends}.{bampaf}.resources.csv"
    input:
        log="runs/{prog}/{dataset_id}/{ends}.{bampaf}.log",
    params:
        typ=lambda wildcards: "map" if wildcards.bampaf == "paf" else "align",
        genome=lambda wc: f"genomes/{get_dataset_param(wc, 'endogenous_genome')}",
        read_len=lambda wc: f"genomes/{get_dataset_param(wc, 'read_length')}"
    shell:
        """
        # user time and peak memory come from `/usr/bin/time -v` for every tool
        user_time=$(awk '/User time/ {{print $NF}}' {input.log})
        memory=$(awk '/Maximum resident/ {{print $NF/1048576}}' {input.log})

        # Mapping (wall-clock) time is parsed from each tool's own log output.
        # The patterns are tried in order; the first non-empty match is used:
        #   strobealign (all strobealign-* variants): "Total time mapping: <s> s"
        mapping_time=$(awk '/Total time mapping:/ {{print $4}}' {input.log})
        #   bwa mem / bwa aln: "[main] Real time: <s> sec; CPU: ..."
        if test -z "${{mapping_time}}"; then mapping_time=$(sed -n -e 's|.* Real time: \\([0-9][0-9.]*\\) sec.*|\\1|p' {input.log}); fi
        #   generic fallback for any tool wrapped in `/usr/bin/time -v`:
        #   "Elapsed (wall clock) time (h:mm:ss or m:ss): <t>"
        if test -z "${{mapping_time}}"; then mapping_time=$(awk '/Elapsed \(wall clock\)/ {{split($NF, a, ":"); if (length(a)==3) print a[1]*3600+a[2]*60+a[3]; else print a[1]*60+a[2]}}' {input.log}); fi

        echo "prog,type,genome,ends,read_length,mapping_time,memory_gb,user_time" > {output.csv}.tmp
        echo "{wildcards.prog},{params.typ},{params.genome},{wildcards.ends},{params.read_len},${{mapping_time}},${{memory}},${{user_time}}" >> {output.csv}.tmp
        mv {output.csv}.tmp {output.csv}
        """
