from itertools import product

configfile: "simx/config/config.yaml"

include: "rules/pipeline.smk"

NUM_READS = config.get("num_reads", 100000)

SCRIPTS = "simx/scripts"
SHARED_SCRIPTS = "shared/scripts"

VARIATION_SETTINGS = {
    "var1": "",
    "var0p05": "--snp-rate 0.0005 --small-indel-rate 0.00005 --max-small-indel-size 30",
    "var0p1": "--snp-rate 0.001 --small-indel-rate 0.0001 --max-small-indel-size 100",
    # "var0p5": "--snp-rate 0.005 --small-indel-rate 0.0005 --max-small-indel-size 50",
    "var0p5": "--snp-rate 0.005 --small-indel-rate 0.001 --max-small-indel-size 100",
    "var2": "--snp-rate 0.02 --small-indel-rate 0.002 --max-small-indel-size 100",
    "var5": "--snp-rate 0.05 --small-indel-rate 0.005 --max-small-indel-size 100",
    "var10": "--snp-rate 0.1 --small-indel-rate 0.01 --max-small-indel-size 100",
}


# Register each dataset with the shared gargammel_simulate rule. Keyed by the
# per-dataset output prefix "simdir" = simx/datasets/{dataset_id}.
GARGAMMEL_REGISTRY = {}
for _did, _p in DATASET_CONFIGS.items():
    GARGAMMEL_REGISTRY[f"simx/datasets/{_did}"] = {
        "endo": [f"simx/genomes/{_p['endogenous_genome']}.fa"],
        "cont": [f"simx/genomes/{_p['contaminant_genome']}.fa"],
        "bact_dir": f"simx/data/gargammel/{_p['bacterial_db']}/fasta",
        "num": NUM_READS,
        "comp": ",".join(map(str, _p["proportions"])),
        "gargammel_args": f"-l {_p['read_length']} -damage 0.03,0.4,0.01,0.3",
    }


include: "../shared/rules/gargammel.smk"


rule all:
    input:
        expand("simx/datasets/{dataset_id}/fastp/1.fq.gz", dataset_id=DATASET_IDS),
        expand("simx/datasets/{dataset_id}/fastp/2.fq.gz", dataset_id=DATASET_IDS),
        expand("simx/datasets/{dataset_id}/ref_ground_truth.bed", dataset_id=DATASET_IDS),
        expand("simx/datasets/{dataset_id}/ref_damage.bed", dataset_id=DATASET_IDS),
        expand("simx/datasets/{dataset_id}/ref.fa", dataset_id=DATASET_IDS),


GENOME_MD5 = {
    "fruitfly": "035a0587c364ff245aac8c951a5bb68d",
    "CHM13": "42b830df45df08ab63068e9128156e56",
    "zymo": "0d3178f4c5b01a6530e7c0e163936331",
}


# fruitfly, CHM13 and ecoli50 rules follow https://github.com/NBISweden/strobealign-evaluation
rule download_fruitfly:
    output: "simx/genomes/fruitfly.fa"
    params: md5=GENOME_MD5["fruitfly"]
    shell:
        """
        curl -fL https://ftp.ensembl.org/pub/release-97/fasta/drosophila_melanogaster/dna/Drosophila_melanogaster.BDGP6.22.dna.toplevel.fa.gz \
            | zcat > {output}.tmp.fa
        samtools faidx {output}.tmp.fa
        # Discard contigs shorter than 16 kbp
        awk '$2>=16000 {{print $1}}' {output}.tmp.fa.fai > {output}.tmp.regions.txt
        samtools faidx -r {output}.tmp.regions.txt {output}.tmp.fa > {output}.tmp2.fa
        rm {output}.tmp.fa {output}.tmp.fa.fai {output}.tmp.regions.txt
        echo "{params.md5}  {output}.tmp2.fa" | md5sum -c
        mv {output}.tmp2.fa {output}
        """


rule download_chm13:
    output: "simx/genomes/CHM13.fa"
    params: md5=GENOME_MD5["CHM13"]
    shell:
        """
        curl -fL https://s3-us-west-2.amazonaws.com/human-pangenomics/T2T/CHM13/assemblies/analysis_set/chm13v2.0.fa.gz \
            | zcat > {output}.tmp.fa
        echo "{params.md5}  {output}.tmp.fa" | md5sum -c
        mv {output}.tmp.fa {output}
        """


# ZymoBIOMICS Microbial Community Standard reference genomes, concatenated in name order.
rule download_zymo:
    output: "simx/genomes/zymo.fa"
    params: md5=GENOME_MD5["zymo"]
    shell:
        """
        tmp=$(mktemp -d)
        curl -fL -o $tmp/refseq.zip https://s3.amazonaws.com/zymo-files/BioPool/ZymoBIOMICS.STD.refseq.v2.zip
        unzip -q -d $tmp $tmp/refseq.zip
        cat $(LC_ALL=C ls $tmp/ZymoBIOMICS.STD.refseq.v2/Genomes/*.fasta) > {output}.tmp.fa
        rm -rf $tmp
        echo "{params.md5}  {output}.tmp.fa" | md5sum -c
        mv {output}.tmp.fa {output}
        """


rule download_ecoli50:
    output:
        "simx/downloads/ecoli50/done.txt"
    input: "simx/data/ecoli-accessions.txt"
    shell:
        "mkdir -p simx/downloads/ecoli50; "
        "head -n 50 {input} > simx/downloads/ecoli50/accessions.txt; "
        "ncbi-genome-download -o simx/downloads/ecoli50 -A simx/downloads/ecoli50/accessions.txt --formats fasta --flat-output bacteria; "
        "touch simx/downloads/ecoli50/done.txt"

rule filter_ecoli50:
    output: "simx/genomes/ecoli50.fa"
    input: "simx/downloads/ecoli50/done.txt"
    shell:
        "python {SCRIPTS}/noplasmids.py simx/downloads/ecoli50/*.fna.gz > {output}"


rule mason_variator:
    output:
        vcf="simx/genomes/{var}/{genome}.vcf"
    input:
        fasta="simx/genomes/{genome}.fa",
        fai="simx/genomes/{genome}.fa.fai",
    params:
        variation_settings=lambda wildcards: VARIATION_SETTINGS[wildcards.var],
        outdir="simx/genomes/{var}"
    shell:
        """
        mkdir -p {params.outdir}
        if [ "{wildcards.var}" = "var1" ]; then
            touch {output.vcf}
        else
            mason_variator -ir {input.fasta} {params.variation_settings} -ov {output.vcf}.tmp.vcf
            mv -v {output.vcf}.tmp.vcf {output.vcf}
        fi
        """


rule fastp_process:
    input:
        s1="simx/datasets/{dataset_id}/simulated_s1.fq.gz",
        s2="simx/datasets/{dataset_id}/simulated_s2.fq.gz"
    output:
        o1="simx/datasets/{dataset_id}/fastp/1.fq.gz",
        o2="simx/datasets/{dataset_id}/fastp/2.fq.gz",
        html="simx/datasets/{dataset_id}/fastp/fastp.html",
        json="simx/datasets/{dataset_id}/fastp/fastp.json"
    threads: 4
    shell:
        """
        fastp --in1 {input.s1} --in2 {input.s2} \
        --out1 {output.o1} --out2 {output.o2} \
        --html {output.html} --json {output.json} \
        --thread {threads}
        """


rule parse_ground_truth:
    input:
        r1="simx/datasets/{dataset_id}/fastp/1.fq.gz",
        r2="simx/datasets/{dataset_id}/fastp/2.fq.gz"
    output:
        gt="simx/datasets/{dataset_id}/endo_ground_truth.bed",
        damage="simx/datasets/{dataset_id}/endo_damage.bed"
    params:
        input_dir=lambda wc: f"simx/datasets/{wc.dataset_id}"
    shell:
        """
        python {SHARED_SCRIPTS}/parse_gargammel.py -d {params.input_dir} -1 {input.r1} -2 {input.r2} \
        -o {output.gt} -D {output.damage}
        """


rule samtools_faidx:
    output: "simx/genomes/{genome}.fa.fai"
    input: "simx/genomes/{genome}.fa"
    shell: "samtools faidx {input}"


rule convert_vcf:
    input: "simx/genomes/{var}/{ref}.vcf"
    output: 
        vcf="simx/genomes/{var}/{ref}-fixed.vcf.gz",
        tbi="simx/genomes/{var}/{ref}-fixed.vcf.gz.tbi"
    params: 
        tmp_out="simx/genomes/{var}/{ref}-fixed.vcf"
    shell: 
        """
        {SCRIPTS}/add_vcf_format.py -i {input} -o "{params.tmp_out}"
        bcftools sort -m 2G {params.tmp_out} | bgzip --stdout > {output.vcf}
        tabix {output.vcf}
        """


rule ref_transform:
    input:
        fasta="simx/genomes/{ref}.fa",
        vcf="simx/genomes/{var}/{ref}-fixed.vcf.gz",
        tbi="simx/genomes/{var}/{ref}-fixed.vcf.gz.tbi"
    output:
        fasta="simx/genomes/{var}/{ref}.fa",
        vci="simx/genomes/{var}/{ref}.vci.gz"
    params:
        outprefix="simx/genomes/{var}/{ref}",
        outvci="simx/genomes/{var}/{ref}.vci"
    singularity:
        "docker://churchilllab/g2gtools:3.0.0"
    shell:
        """
        g2gtools vcf2vci --vci {params.outvci} --vcf {input.vcf} --fasta {input.fasta} --strain simulated -v
        g2gtools patch --fasta {input.fasta} --vci {output.vci} --out {params.outprefix}.patched.fa
        g2gtools transform --fasta {params.outprefix}.patched.fa --vci {output.vci} --out {output.fasta}
        """

rule gt_liftover:
    input:
        gt="simx/datasets/{dataset_id}/endo_ground_truth.bed",
        damage="simx/datasets/{dataset_id}/endo_damage.bed",
        vci=lambda wc: f"simx/genomes/{get_dataset_param(wc, 'endogenous_variation')}/{get_dataset_param(wc, 'endogenous_genome')}.vci.gz",
        fasta=lambda wc: f"simx/genomes/{get_dataset_param(wc, 'endogenous_variation')}/{get_dataset_param(wc, 'endogenous_genome')}.fa"
    output:
        gt="simx/datasets/{dataset_id}/ref_ground_truth.bed",
        damage="simx/datasets/{dataset_id}/ref_damage.bed",
        fasta="simx/datasets/{dataset_id}/ref_unsanitized.fa"
    params:
        unmapped="simx/datasets/{dataset_id}/ref_ground_truth.bed.unmapped",
        damage_unmapped="simx/datasets/{dataset_id}/ref_damage.bed.unmapped"
    singularity:
        "docker://churchilllab/g2gtools:3.0.0"
    shell:
        """
        g2gtools convert --in {input.gt} --vci {input.vci} -f BED --out {output.gt}
        cat {params.unmapped} >> {output.gt}
        if [ -s {input.damage} ]; then
            g2gtools convert --in {input.damage} --vci {input.vci} -f BED --out {output.damage}
            if [ -f {params.damage_unmapped} ]; then
                cat {params.damage_unmapped} >> {output.damage}
            fi
        else
            : > {output.damage}
        fi
        ln -sfr {input.fasta} {output.fasta}
        """


rule sanitize_ref:
    input:
        fasta="simx/datasets/{dataset_id}/ref_unsanitized.fa"
    output:
        fasta="simx/datasets/{dataset_id}/ref.fa"
    shell:
        """
        {SCRIPTS}/remove_nonacgt.py -i {input.fasta} -o {output.fasta}
        """
